# ModelAny × zens-ink API keys
# Copy to .env and fill values:  cp .env.example .env
# Run tools via:                 ./seo/zens.sh <command>
# Never commit .env

# ── SSL (required on this Mac Python for Google Suggest) ─────
# ./seo/zens.sh sets this automatically via certifi.

# ── Serper.dev — Keyword Difficulty (kd) / SERP ──────────────
# Cost: FREE 2,500 queries on signup (no credit card).
# After free credits: prepaid packs from ~$50 (optional).
# Signup: https://serper.dev → Dashboard → API Key
SERPER_API_KEY=

# ── Bing Webmaster — Keyword Volume (keyword_volume / kgr) ───
# Cost: FREE forever (API key for verified site owners).
# Steps:
#   1. https://www.bing.com/webmasters  (Microsoft / Google login OK)
#   2. Add & verify https://www.modelany.app (or sc-domain:modelany.app)
#   3. Settings (top right) → API Access → Generate API Key
BING_API_KEY=

# ── Brave Search (optional volume cross-check) ───────────────
# Cost: FREE 2,000 queries/month.
# Signup: https://brave.com/search/api/
BRAVE_API_KEY=

# ── Ahrefs Domain Rating (optional) ──────────────────────────
# Cost: FREE public DR endpoint key.
# Signup: https://app.ahrefs.com → Account settings → API keys
AHREFS_API_KEY=

# ── Google Search Console — real ranking / impressions ───────
# Cost: FREE (Google Cloud OAuth + GSC; no per-query fee).
# GSC property must already list modelany.app as verified.
#
# Option A — URL-prefix property:
#   GSC_SITE_URL=https://www.modelany.app/
# Option B — Domain property:
#   GSC_SITE_URL=sc-domain:modelany.app
GSC_SITE_URL=https://www.modelany.app/

# One-time OAuth for setup_gsc (Desktop app client):
#   1. https://console.cloud.google.com/apis/library/searchconsole.googleapis.com
#      → Enable "Google Search Console API"
#   2. https://console.cloud.google.com/apis/credentials
#      → Create Credentials → OAuth client ID → Desktop app
#   3. Paste Client ID / Secret below, then run:
#      ./seo/zens.sh setup_gsc
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ADC_PATH=~/.config/gcloud/application_default_credentials.json
